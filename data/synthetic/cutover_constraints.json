      "name": "Integration readiness review"
    },
    {
      "milestone_id": "MS-CUTOVER-READINESS",
      "offset": "T-7",
      "name": "Cutover readiness review"
    },
    {
      "milestone_id": "MS-CODE-FREEZE",
      "offset": "T-5",
      "name": "Code freeze"
    },
    {
      "milestone_id": "MS-DATA-FREEZE",
      "offset": "T-2",
      "name": "Data freeze"
    },
    {
